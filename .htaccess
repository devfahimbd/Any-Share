# ====================================================================
# Any Share - Apache Security & Hardening Configuration
# ====================================================================

# Disable directory listing globally across the site
Options -Indexes

# Block sensitive configuration, database schemas, and git metadata
<FilesMatch "^(config\.ini|\.env|\.git.*|schema\.sql|cleanup\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block direct web access to internal includes and uploads directories
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^includes/ - [F,L]
    RewriteRule ^uploads/ - [F,L]
</IfModule>
